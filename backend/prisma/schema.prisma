generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PUBLICO
  ANALISTA
  ADMIN
}

enum TipoZona {
  DEPARTAMENTO
  MUNICIPIO
  BARRIO
}

enum Categoria {
  HOMICIDIO
  LESIONES
  VIOLENCIA_GENERO
  VIOLENCIA_INTRAFAMILIAR
  ROBO
  HURTO
  HURTO_VEHICULO
  ESTAFA_ONLINE
}

enum FranjaHoraria {
  MADRUGADA
  MANANA
  TARDE
  NOCHE
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  nombre       String
  passwordHash String
  role         Role     @default(ANALISTA)
  createdAt    DateTime @default(now())
}

model Zona {
  id         Int                  @id @default(autoincrement())
  nombre     String
  tipo       TipoZona
  localidad  String
  poblacion  Int
  lat        Float
  lng        Float
  incidentes Incidente[]
  servicios  ServicioAsistencia[]

  @@unique([nombre, localidad])
}

model Incidente {
  id        Int           @id @default(autoincrement())
  categoria Categoria
  fecha     DateTime
  franja    FranjaHoraria
  lat       Float
  lng       Float
  zonaId    Int
  zona      Zona          @relation(fields: [zonaId], references: [id])
  sintetico Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@index([categoria, fecha])
  @@index([zonaId, fecha])
}

model Recomendacion {
  id              Int            @id @default(autoincrement())
  categoria       Categoria
  franja          FranjaHoraria?
  umbralTasa      Float
  accion          String
  evidencia       String
  activa          Boolean        @default(true)
}

model ServicioAsistencia {
  id       Int    @id @default(autoincrement())
  nombre   String
  tipo     String
  contacto String
  zonaId   Int
  zona     Zona   @relation(fields: [zonaId], references: [id])
}
